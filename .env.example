# Copy this to .env.local for local development

# Required — Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Production only — Railway Python backend URL
# Leave blank for local dev (Python is spawned directly)
PYTHON_BACKEND_URL=

# Optional — path to Python executable (local dev only)
# Default: "python" — override if your system uses "python3"
PYTHON_PATH=python
